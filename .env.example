# GoKwik / KwikPass credentials — obtain these from the GoKwik merchant dashboard.
# Copy this file to `.env` and fill in real values. NEVER commit `.env` or real values.
# GOKWIK_APP_SECRET is the authenticating x-api-key for api.gokwik.co — keep it secret;
# ideally it should live server-side and not be shipped in the mobile client bundle.
GOKWIK_APP_ID=your_gokwik_app_id
GOKWIK_APP_SECRET=your_gokwik_app_secret

# Shopify storefront (see README) — not secret config, but kept out of source likewise.
SHOPIFY_STORE_DOMAIN=your-brand.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_token
BRAND_NAME=Your Brand Name
